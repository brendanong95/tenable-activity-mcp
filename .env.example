# Copy to .env and fill in real values. Never commit .env.
#
# Tenable Vulnerability Management API keys (Settings > My Account > API Keys).
# The owning user needs the Administrator role, or a custom role with explicit
# audit-log read permission - see README.md.
TENABLE_ACCESS_KEY=your_access_key_here
TENABLE_SECRET_KEY=your_secret_key_here

# API base URL. Change only for a regional or FedRAMP tenant.
TENABLE_MCP_BASE_URL=https://cloud.tenable.com

# Where the local SQLite state (cursors + per-actor baselines) is written.
# Defaults to state.db in the project root; created automatically on first run.
# TENABLE_MCP_STATE_DB=./state.db
